{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "invi-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173
    },
    {
      "name": "invi-frontend-localhost",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host",
        "localhost"
      ],
      "port": 5173
    },
    {
      "name": "invi-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "backend\\gradlew.bat",
        "-p",
        "backend",
        "bootRun",
        "--args=--spring.profiles.active=local --server.address=127.0.0.1 --invi.frontend.base-url=http://localhost:5173",
        "--console=plain"
      ],
      "port": 8080
    }
  ]
}
